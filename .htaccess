Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On

# Force the non-www canonical host over HTTPS.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.bizitsolutions\.com\.au$ [NC]
RewriteRule ^ https://bizitsolutions.com.au%{REQUEST_URI} [R=301,L]

# Retired service pages now resolve to the current service offering anchors.
RewriteRule ^business-it-support(?:\.html)?/?$ /services#it-managed-services [R=301,L,NE]
RewriteRule ^microsoft-365(?:\.html)?/?$ /services#it-managed-services [R=301,L,NE]
RewriteRule ^microsoft-azure(?:\.html)?/?$ /services#it-consultancy [R=301,L,NE]
RewriteRule ^managed-services(?:\.html)?/?$ /services#it-managed-services [R=301,L,NE]
RewriteRule ^it-security(?:\.html)?/?$ /services#security-operations-center [R=301,L,NE]
RewriteRule ^web-design-services(?:\.html)?/?$ /services#it-consultancy [R=301,L,NE]
RewriteRule ^seo-google-ads(?:\.html)?/?$ /services#it-consultancy [R=301,L,NE]

# Serve extensionless clean URLs from matching .html files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Redirect direct .html requests to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
